# Copy to `.env` and adjust. Loaded by dotenvy in development (and sourced by
# `nix run .#cabinet-backend`). Topology DEFAULTS live in flake.nix (`ports`); anything set
# here or in the environment wins.
RUST_LOG=info,invest_cabinet_backend=debug

# ── HTTP ──────────────────────────────────────────────────────────────────────
# CABINET_BACKEND_BIND=127.0.0.1:50072
# The cabinet's public origin: the redirect URI is <origin>/cabinet/auth/callback, and
# the only `Origin` a mutation or the book socket is accepted from. In dev, the Next
# server's (`npm run dev` in cabinet/frontend).
CABINET_PUBLIC_ORIGIN=http://localhost:3000

# ── Session store: the `cabinet` schema of the `invest` database ─────────────
# DATABASE_URL=postgres://postgres@localhost:5432/invest
# DB_MAX_CONNECTIONS=5

# ── invest-core ───────────────────────────────────────────────────────────────
# INVEST_CORE_GRPC_ADDR=http://127.0.0.1:50071

# ── concierge: the relying party `invest` ─────────────────────────────────────
# CONCIERGE_GRPC_ADDR=http://127.0.0.1:55670
# CONCIERGE_CLIENT_ID=invest
# The value concierge holds as RP_CLIENT_SECRET_INVEST.
CONCIERGE_CLIENT_SECRET=
# Where the browser is sent to authorize.
# CONCIERGE_PUBLIC_ORIGIN=https://evinvest.ltd

# Cookie security: `__Host-` + Secure cookies need HTTPS, which http://localhost rejects —
# false in local dev, true in production (unset ⇒ inferred from APP_ENV). Must match the
# frontend's AUTH_COOKIE_SECURE: it decides the cookies' names.
AUTH_COOKIE_SECURE=false

# ── Observability (each integration no-ops when unset) ────────────────────────
SENTRY_DSN=
APP_ENV=development

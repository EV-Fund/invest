# Copy to `.env.local` and adjust.

# The invest BFF's origin (`nix run .#cabinet-backend`, :50072). /cabinet/api/* and the
# sign-in callback /cabinet/auth/* are rewritten there with their paths intact. Required:
# next.config.ts refuses to start without it (it is baked into the build's route manifest).
CABINET_BACKEND_URL=http://127.0.0.1:50072

# Cookie security: `__Host-`+Secure cookies need HTTPS, which http://localhost
# rejects — leave false in local dev, true in production (or unset to infer from
# NODE_ENV). Must match the BFF's setting: it decides the session cookie's name.
AUTH_COOKIE_SECURE=false

# Extra CSP script/style/connect sources beyond the platform's element directories
# (https://evinvest.ltd/api/auth/mfe/, https://evinvest.ltd/wallet/mfe/) — a staging
# stand's, say. Space/comma-separated.
MFE_ALLOWED_ORIGINS=

# ── Observability (each integration no-ops when unset) ────────────────────────
# Product analytics (PostHog) — browser. Empty key → capture is a silent no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Error monitoring (Sentry) — browser. Required when NODE_ENV=production
# (`next start`); any DSN-shaped value works for a local production run.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development

# Error monitoring (Sentry) — server/runtime (instrumentation.ts → register).
SENTRY_DSN=
APP_ENV=development
